# =====================================================================
# X Tech Digest Configuration (100% Free Setup)
# =====================================================================

# 1. Google Gemini API Key (100% Free)
# Get your free key in 30 seconds at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Email Delivery Configuration (Free Gmail SMTP)
# To use Gmail:
#   1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#   2. Generate an "App Password" (choose Other, name it "X Tech Digest"): https://myaccount.google.com/apppasswords
#   3. Paste the 16-character App Password below (NOT your standard Gmail password).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=u@gmail.com
SMTP_PASS=u
SENDER_EMAIL=u@gmail.com
RECIPIENT_EMAIL=u@gmail.com

# 3. Optional: Resend API (Alternative free option - 3000 emails/month free)
# Only needed if EMAIL_PROVIDER=resend
RESEND_API_KEY=

# 4. Scraper Settings
# You can change this to a specific X list or keep it as home feed
X_FEED_URL=https://x.com/home
MAX_TWEETS_TO_SCAN=60
SCROLL_COUNT=8
HEADLESS=true
